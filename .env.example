DATABASE_URL=file:../db/custom.db
# Casa de los datos FUERA del repo (change athena-home-cli). Si la defines,
# la BD (custom.db), la config (config.json), el candado y los ficheros
# subidos viven ahí: <ATHENA_HOME>/db y <ATHENA_HOME>/uploads. Sin ella, el
# código usa los datos del repo si existen (db/custom.db) y, en una
# instalación nueva sin Docker, ~/.local/share/athena (estándar XDG).
# El CLI de la casa (bin/athena) entiende la misma regla:
#   bin/athena init · start [--lan] · doctor · backup · home · migrate-home
# Ver src/core/data-home.ts y docs/SELFHOSTING.md.
# ATHENA_HOME=~/.local/share/athena
# La contraseña del candado — ATHENA_PASSWORD (la antigua ATENA_PASSWORD del
# .env sigue leyéndose si no defines la nueva):
#   bun run dev      → modo normal (solo localhost, abierto a menos que definas
#                      contraseña)
#   bun run dev:lan  → modo lan (0.0.0.0): candado con esta contraseña, o una
#                      autogenerada que se muestra por terminal al primer
#                      arranque y queda en db/athena-lock
# ¿Visitantes en tu red y NO quieres cerrar la casa? En modo lan,
# ATHENA_ABIERTO=1 la deja abierta sin candado (si defines una contraseña
# explícita, esa manda).
# Documentación: docs/INDICE.md (mapa completo) y docs/guias/auto-alojamiento.md.
# ATHENA_PASSWORD=mi-contraseña
# ATHENA_ABIERTO=1
