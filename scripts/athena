#!/usr/bin/env bash
# Athena · CLI de la casa
#
# Orquesta la casa de datos (ATHENA_HOME) y el arranque del servidor:
#
#   athena init          crea las carpetas de la casa de datos
#   athena start [--lan] arranca Athena (offline o lan); la BD se crea sola
#   athena doctor        revisa bun, casa de datos, BD, uploads y permisos
#   athena backup [dest] copia de seguridad completa (db + uploads) en un tar.gz
#   athena bundle [dest] artefacto standalone (solo Node) en release/, sin tu biblioteca
#   athena home          imprime las rutas resueltas
#   athena migrate-home  mueve una instalación legacy (datos dentro del repo) a la casa
#
# Resolución de la casa (misma lógica que src/core/data-home.ts):
#   1. ATHENA_HOME definida → esa carpeta
#   2. datos legacy en el repo (db/custom.db) → el repo MANDA (no se mueve solo)
#   3. default XDG: $XDG_DATA_HOME/athena o ~/.local/share/athena
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$ROOT"

# --- resolución de la casa -------------------------------------------------
casa() {
  local explicita="${ATHENA_HOME:-}"
  if [ -n "${explicita// /}" ]; then
    mkdir -p "$explicita"
    readlink -f "$explicita"
    return
  fi
  if [ -f "$ROOT/db/custom.db" ]; then echo ""; return; fi      # legacy: repo manda
  echo "${XDG_DATA_HOME:-$HOME/.local/share}/athena"
}

CASA="$(casa)"
if [ -n "$CASA" ]; then
  DB="$CASA/db/custom.db"
  UPLOADS="$CASA/uploads"
else
  DB="$ROOT/db/custom.db"
  UPLOADS="$ROOT/public/uploads"
fi

dependencias() { [ -d "$ROOT/node_modules/vite" ]; }

# --- comandos ---------------------------------------------------------------
cmd_home() {
  echo "casa:    ${CASA:-<repo> (modo legacy)}${ATHENA_HOME:+  (ATHENA_HOME definida)}"
  echo "db:      $DB"
  echo "uploads: $UPLOADS"
  [ -n "$CASA" ] || echo "nota:    datos legacy dentro del repo; «athena migrate-home» los lleva a su casa"
}

cmd_init() {
  if [ -z "$CASA" ]; then
    echo "Athena corre en modo legacy (datos dentro del repo): nada que iniciar."
    [ -f "$DB" ] && echo "BD lista: $DB"
    exit 0
  fi
  if [ -f "$ROOT/db/custom.db" ]; then
    echo "⚠ Hay datos legacy dentro del repo (db/custom.db). Ejecuta antes:"
    echo "    scripts/athena migrate-home"
    exit 2
  fi
  mkdir -p "$CASA/db" "$CASA/uploads"
  echo "Casa de datos: $CASA"
  echo "La BD nace sola en el primer arranque ($DB)."
  echo "Listo. Arranca con: scripts/athena start   (o bun run start)"
}

cmd_migrate_home() {
  [ -n "$CASA" ] || { echo "Ya estás en modo legacy con datos en el repo: nada que migrar."; exit 0; }
  if [ -f "$DB" ]; then
    echo "La casa ya tiene BD ($DB): no se pisa nada. Abortado."; exit 2
  fi
  local hay=0
  for f in "$ROOT"/db/*; do
    [ -e "$f" ] || continue
    hay=1
  done
  local hay_up=0
  for f in "$ROOT"/public/uploads/*; do
    [ -e "$f" ] || continue
    [ "$(basename "$f")" = ".gitkeep" ] && continue
    hay_up=1
  done
  if [ "$hay" = 0 ] && [ "$hay_up" = 0 ]; then
    echo "No hay datos legacy en el repo: nada que migrar. Usa «athena init»."
    exit 0
  fi
  mkdir -p "$CASA/db" "$CASA/uploads"
  echo "Moviendo datos del repo → $CASA"
  if [ "$hay" = 1 ]; then
    for f in "$ROOT"/db/*; do
      [ -e "$f" ] || continue
      mv "$f" "$CASA/db/"
      echo "  db/$(basename "$f")"
    done
  fi
  if [ "$hay_up" = 1 ]; then
    for f in "$ROOT"/public/uploads/*; do
      [ "$(basename "$f")" = ".gitkeep" ] && continue
      mv "$f" "$CASA/uploads/"
      echo "  uploads/$(basename "$f")"
    done
  fi
  echo "Hecho. Tu biblioteca vive ahora en $CASA"
  echo "Arranca con: scripts/athena start   (bun run start también la encuentra)"
}

cmd_bundle() {
  local destino="${1:-$ROOT/release}"
  [ -f "$ROOT/server-dist/server.cjs" ] || {
    echo "No hay build de producción ($ROOT/server-dist). Ejecuta antes: bun run build"
    exit 1
  }
  command -v node >/dev/null || {
    echo "Node no está en el PATH (el artefacto se arranca con Node, sin Bun)."
    exit 1
  }
  node scripts/build-standalone-bundle.mjs "$destino"
}

cmd_start() {
  local lan=0
  [ "${1:-}" = "--lan" ] && lan=1
  [ -f "$ROOT/server-dist/server.cjs" ] || {
    echo "No hay build de producción ($ROOT/server-dist). Ejecuta: bun run build"
    exit 1
  }
  # BD cero-config: si falta, el propio servidor la crea al arrancar.
  if [ ! -f "$DB" ]; then
    mkdir -p "$(dirname "$DB")" "$(dirname "$UPLOADS")"
    echo "La biblioteca nacerá en $DB al arrancar."
  fi
  # El log del servidor va a la casa de datos (escribible por la persona;
  # imprescindible cuando la app vive en /opt/athena tras instalar el .deb).
  # En modo legacy queda en el repo como siempre (tee server.log).
  if [ -n "$CASA" ]; then export ATHENA_LOG="$CASA/server.log"; fi
  if command -v bun >/dev/null 2>&1; then
    if [ "$lan" = 1 ]; then
      exec bun run start:lan
    else
      exec bun run start
    fi
  fi
  # sin Bun: el build ya va self-contained, Node directo sirve igual
  echo "(sin bun en el PATH: arranco con node directo)"
  if [ "$lan" = 1 ]; then
    exec env ATHENA_MODO=lan ATHENA_HOST=0.0.0.0 node "$ROOT/server-dist/server.cjs"
  fi
  exec env ATHENA_MODO=offline node "$ROOT/server-dist/server.cjs"
}

cmd_doctor() {
  local fallos=0
  di() { echo "  ✅ $1"; }
  dw() { echo "  ⚠️  $1"; }
  df() { echo "  ❌ $1"; fallos=$((fallos+1)); }
  echo "Athena doctor"
  echo "· Bun"
  command -v bun >/dev/null && di "bun $(bun --version)" || df "bun no está en el PATH"
  echo "· Casa de datos"
  if [ -n "$CASA" ]; then
    di "modo home: $CASA"
    [ -d "$CASA/db" ] && di "db/ existe" || dw "db/ no existe aún (athena init la crea)"
    [ -d "$UPLOADS" ] && di "uploads/ existe" || dw "uploads/ no existe aún (athena init la crea)"
    if [ -d "$CASA/db" ]; then
      touch "$CASA/db/.escribe-test" 2>/dev/null && rm -f "$CASA/db/.escribe-test" \
        && di "db/ es escribible" || df "db/ NO es escribible"
    fi
  else
    dw "modo legacy (datos dentro del repo) — considera «athena migrate-home»"
  fi
  echo "· Biblioteca"
  if [ -f "$DB" ]; then
    di "BD: $DB ($(du -h "$DB" | cut -f1))"
  else
    dw "sin BD en $DB (nacerá sola al arrancar)"
  fi
  if [ -d "$UPLOADS" ]; then
    local n
    n=$(find "$UPLOADS" -type f ! -name ".gitkeep" | wc -l)
    di "uploads: $n fichero(s) ($(du -sh "$UPLOADS" | cut -f1))"
  fi
  [ -f "$(dirname "$DB")/config.json" ] && di "config.json presente" || dw "config.json aún no existe (se crea al primer uso)"
  echo "· Servidor"
  dependencias && di "dependencias instaladas (node_modules)" || dw "sin node_modules (bun install)"
  [ -f "$ROOT/server-dist/server.cjs" ] && di "build de producción presente" || dw "sin build (server-dist) — bun run build"
  if command -v node >/dev/null; then
    node -e "const v=process.versions.node.split('.').map(Number); if(v[0]>23||(v[0]===23&&v[1]>=4)) process.exit(0); process.exit(1)" 2>/dev/null \
      && di "node $(node --version) (SQLite integrado)" \
      || dw "node $(node --version) viejo para producción (pide ≥ 23.4)"
  fi
  echo ""
  if [ "$fallos" = 0 ]; then echo "Todo en orden (o nada bloqueante)."; else echo "$fallos problema(s) bloqueante(s)."; exit 1; fi
}

cmd_backup() {
  [ -n "$CASA" ] || { echo "En modo legacy: copia a mano db/ y public/uploads/ (ver README)."; exit 2; }
  local dest="${1:-$CASA/backups}"
  [ -f "$DB" ] || { echo "No hay BD que respaldar ($DB). ¿athena init?"; exit 1; }
  mkdir -p "$dest"
  local fichero="$dest/athena-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
  tar czf "$fichero" -C "$CASA" db uploads
  echo "Copia completa (BD + config + candado + ficheros):"
  echo "  $fichero ($(du -h "$fichero" | cut -f1))"
}

case "${1:-}" in
  init) cmd_init ;;
  start) shift; cmd_start "$@" ;;
  doctor) cmd_doctor ;;
  backup) shift; cmd_backup "$@" ;;
  bundle) shift; cmd_bundle "$@" ;;
  home) cmd_home ;;
  migrate-home) cmd_migrate_home ;;
  ""|-h|--help|help)
    sed -n '2,15p' "$(readlink -f "$0")" | sed 's/^# \{0,1\}//'
    ;;
  *) echo "Comando desconocido: $1 (athena --help)"; exit 1 ;;
esac
