<?xml version="1.0" encoding="utf-8"?>
<!--
  Icono adaptativo (Android 8.0+). Es el que se ve en la práctica: cualquier
  móvil moderno usa esto y NO los PNG de mipmap-*.

  Estaba apuntando a @mipmap/ic_launcher_foreground, el PNG que trae la
  plantilla de Capacitor (la X azul): por eso el launcher seguía enseñando el
  icono viejo aunque el fondo ya fuera sepia. El vector del pórtico existía en
  drawable/ pero nadie lo referenciaba.

  `monochrome` (Android 13+): cuando el usuario activa los iconos con el tema
  del sistema, el launcher tiñe esta capa con el color del fondo de pantalla.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
