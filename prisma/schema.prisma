generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Book {
  id          String           @id @default(cuid())
  title       String
  author      String?
  fileName    String
  filePath    String
  coverPath   String?
  totalPages  Int
  currentPage Int              @default(1)
  milestones  Int?             // tramos/hitos de ESTE libro; null = usar el global
  dailyGoal   Int?             // meta diaria de ESTE libro (1-500); null = usar el mínimo global
  // Lectura dual: PDF compañero (traducción / segunda edición), sincronizado por progreso
  companionPath  String?
  companionPages Int?
  // Datos de los modos de lectura (fichas, notación, resultados, predicción...) como JSON
  extras      Json?
  // Colección de insignias: lectura completada y cuántas veces se ha terminado el libro
  finishedAt  DateTime?
  readCount   Int       @default(0)
  badge       Badge?
  createdAt   DateTime  @default(now())
  lastReadAt  DateTime?
  sessions    ReadingSession[]
  // Procedencia del fichero (change cfg-y-biblioteca-por-carpeta):
  //  "subido"  → copia viva en public/uploads/ (la papelera SÍ la mueve)
  //  "carpeta" → registrado en su sitio desde la carpeta escaneada; el fichero
  //              es de la dueña y la app JAMÁS lo mueve, renombra ni escribe.
  origin        String    @default("subido")
  /** sha256 del fichero (desempate ante rutas distintas + detección de reemplazo) */
  fileHash      String?
  /** tamaño y mtime de la última huella guardada: si no cambiaron, no se re-hash
   */
  fileBytes     Int?
  fileMtime     Float?
  /** null = fichero presente; fecha en que el escáner dejó de encontrarlo */
  fileMissingAt DateTime?
}

/**
 * Vocabulario global (change cfg-y-biblioteca-por-carpeta): es DATA de la
 * dueña, no configuración — vive SOLO en la BD, nunca en db/config.json ni
 * en el localStorage (eso solo era caché hasta migrar).
 */
model Vocab {
  id        String   @id @default(cuid())
  word      String
  lang      String   // "es" | "en"
  short     String   // definición recortada
  bookId    String?
  bookTitle String
  page      Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([word, lang])
  @@index([createdAt])
}

/**
 * Insignia coleccionable por libro terminado. El tier sube con cada relectura:
 * 1 Bronce · 2 Plata · 3 Oro · 4+ Diamante. Solo existe si el libro es válido
 * (título + autor). Al borrar el libro, su insignia desaparece con él.
 */
model Badge {
  id        String   @id @default(cuid())
  bookId    String   @unique
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tier      Int      @default(1)
  readings  Int      @default(1)
  earnedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReadingSession {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pagesRead Int      @default(0)
  minutes   Int      @default(0)
  date      DateTime @default(now())

  @@index([bookId, date])
}
