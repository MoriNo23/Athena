{
  "name": "athena",
  "version": "2.1.0",
  "description": "Finish your books. Local-first reading app with a progress rail, streaks, finish badges and a letter-by-letter teleprompter mode.",
  "private": true,
  "scripts": {
    "dev": "ATHENA_MODO=offline node scripts/dev.mjs",
    "dev:lan": "ATHENA_MODO=lan node scripts/dev.mjs --host",
    "build": "node scripts/sync-pdfjs.mjs && vite build && node scripts/build-server.mjs",
    "start": "ATHENA_MODO=offline node server-dist/server.cjs 2>&1 | tee \"${ATHENA_LOG:-server.log}\"",
    "start:lan": "ATHENA_MODO=lan ATHENA_HOST=0.0.0.0 node server-dist/server.cjs 2>&1 | tee \"${ATHENA_LOG:-server.log}\"",
    "lint": "eslint .",
    "athena": "bash scripts/athena",
    "postinstall": "node scripts/sync-pdfjs.mjs",
    "test": "bun test",
    "apk:web": "node scripts/build-apk-web.mjs",
    "apk:sync": "node scripts/build-apk-web.mjs && bunx cap sync android",
    "apk:release": "bun run apk:sync && cd android && ./gradlew assembleRelease",
    "apk:debug": "bun run apk:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7",
    "@capacitor/core": "^7",
    "@fontsource-variable/eb-garamond": "^5.2.5",
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/geist": "^5.2.5",
    "@fontsource-variable/geist-mono": "^5.2.5",
    "@fontsource-variable/literata": "^5.2.5",
    "@fontsource/atkinson-hyperlegible": "^5.2.5",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.525.0",
    "multer": "^2.0.2",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "bun-types": "^1.3.4",
    "esbuild": "^0.27.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.0"
  }
}
