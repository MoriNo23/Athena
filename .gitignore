# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build de la casa (vite + esbuild) y paquetes de release
/dist/
/out/
/server-dist/
/standalone/
/release/
/build

# misc
.DS_Store
# estado local del agente (sesiones/habilidades de OpenCode)
/.opencode/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (nothing reads them anymore; ATHENA_PASSWORD goes in the shell)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt
server.log

# workspace-only directories (not part of the product)
/skills/
/tool-results/
/download/
/upload/
/examples/
/mini-services/
/.clawhub/
/.metrics/
/worklog.md
graphify-out/
scripts/clean-test-copy/
# build del APK: aparta temporalmente api/proxy/login (scripts/build-apk-web.mjs)
/.apk-tmp/

# your library lives on your machine, not in the repo
/db/*
/public/uploads/*
!public/uploads/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm

# pdf.js assets synced from node_modules by scripts/sync-pdfjs.mjs
/public/pdfjs/

# test evidence and heavy artifacts
scripts/*.png
scripts/*.pdf
scripts/state-backup.json
scripts/vlm-*.json
scripts/audit-profile/
scripts/audit-snapshots/
scripts/user-state-snapshot/

# python
__pycache__/
.venv/
scripts/verify-*.txt
/public/evidencia/
*.patch
