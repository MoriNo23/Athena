# dependencies
node_modules

# build output (vite + esbuild) and release packages
/dist/
/out/
/server-dist/
/standalone/
/release/
/build

# env files (nothing reads them anymore; ATHENA_PASSWORD goes in the shell)
.env*

# misc
.DS_Store
*.pem
*.log
*.tsbuildinfo
*.patch

# local ad-hoc artifacts
local-*
test
prompt
.claude
.z-ai-config

# workspace-only directories (agent sandbox, not part of the product)
/skills/
/tool-results/
/download/
/upload/
/examples/
/mini-services/
/.clawhub/
/.metrics/
/worklog.md
/.apk-tmp/

# your library lives on your machine, not in the repo
/db/*
/public/uploads/*
!public/uploads/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm

# pdf.js assets synced from node_modules by scripts/sync-pdfjs.mjs
/public/pdfjs/

# test evidence and heavy artifacts
scripts/*.png
scripts/*.pdf
scripts/state-backup.json
scripts/vlm-*.json
scripts/audit-profile/
scripts/audit-snapshots/
scripts/user-state-snapshot/
