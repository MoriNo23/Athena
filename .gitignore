# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
# estado local del agente (sesiones/habilidades de OpenCode)
/.opencode/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (the example is committed on purpose)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt
server.log

# workspace-only directories (not part of the product)
/skills/
/tool-results/
/download/
/upload/
/examples/
/mini-services/
/.clawhub/
/.metrics/
/worklog.md
graphify-out/
scripts/clean-test-copy/

# your library lives on your machine, not in the repo
/db/*
!db/.gitkeep
/public/uploads/*
!public/uploads/.gitkeep
*.db
*.db-journal

# test evidence and heavy artifacts
scripts/*.png
scripts/*.pdf
scripts/state-backup.json
scripts/vlm-*.json
# audit artifacts (impeccable Task 41): snapshots, browser profiles and the
# USER'S private state snapshot (db + uploaded books) never travel in the repo
scripts/audit-profile/
scripts/audit-snapshots/
scripts/user-state-snapshot/

# python
__pycache__/
.venv/
scripts/impeccable-*.txt
scripts/impeccable-*.json
scripts/verify-*.txt
/evidencia/
